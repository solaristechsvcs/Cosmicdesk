{
  "name": "cosmicdesk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "migrate": "node src/migrate.js",
    "test": "node --test",
    "check": "node --check server.js && node --check src/app.js",
    "format": "prettier --write src server.js test public/style.css"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.1",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "mysql2": "$mysql2"
  }
}